{
  "name": "config",
  "version": "1.0.0",
  "description": "config monorepo",
  "license": "MIT",
  "author": "CoolColdUK",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "clean": "npm run clean:dist && npm run clean:lock && npm run clean:node",
    "clean:dist": "lerna run clean:dist",
    "clean:lock": "find . -name 'package-lock.json' -type f -prune -exec rm -rf '{}' +",
    "clean:node": "lerna run clean:node",
    "pack": "lerna run pack",
    "prepare": "husky",
    "release:major": "lerna version major -y",
    "release:minor": "lerna version minor -y",
    "release:patch": "lerna version patch -y",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@coolcolduk/prettier-config": "^4.0.0",
    "lerna": "^9.0.4"
  },
  "keywords": [
    "config"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --ignore-unknown"
    ],
    "package.json": "prettier-package-json --write"
  },
  "prettier": "@coolcolduk/prettier-config"
}
