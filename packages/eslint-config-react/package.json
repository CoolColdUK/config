{
  "name": "@coolcolduk/eslint-config-react",
  "version": "5.1.0",
  "description": "EsLint config for react",
  "license": "MIT",
  "type": "module",
  "main": "eslint.config.js",
  "files": [
    "eslint.config.js"
  ],
  "scripts": {
    "clean:dist": "rm -rf dist && rm -rf tsconfig.tsbuildinfo",
